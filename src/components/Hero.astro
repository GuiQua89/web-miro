---
// Hero section with typewriter effect and subtle grid background
---

<section
    style="background: var(--cream); min-height: 100svh; display: flex; align-items: center; padding-top: 72px; position: relative; overflow: hidden;"
>
    <!-- Subtle grid background -->
    <div
        aria-hidden="true"
        style="
            position: absolute;
            inset: 0;
            background-image:
                linear-gradient(rgba(26,95,212,0.045) 1px, transparent 1px),
                linear-gradient(90deg, rgba(26,95,212,0.045) 1px, transparent 1px);
            background-size: 48px 48px;
            pointer-events: none;
            z-index: 0;
        "
    ></div>

    <!-- Content -->
    <div
        style="max-width: var(--container); margin: 0 auto; width: 100%; padding: clamp(60px, 10vw, 100px) 24px clamp(80px, 10vw, 120px); position: relative; z-index: 1; text-align: center;"
    >
        <!-- Eyebrow label -->
        <span
            class="fade-in"
            style="display: inline-block; font-family: 'Outfit', sans-serif; font-size: 11px; font-weight: 600; letter-spacing: 0.14em; text-transform: uppercase; color: var(--blue); background: var(--blue-subtle); padding: 6px 16px; border-radius: 100px; margin-bottom: 28px;"
        >
            AGENCIA DE IA Y MARKETING DIGITAL · LATAM
        </span>

        <!-- H1 with typewriter -->
        <h1
            class="fade-in"
            style="font-family: 'Outfit', sans-serif; font-size: clamp(34px, 8vw, 88px); font-weight: 800; color: var(--black); line-height: 1.05; letter-spacing: -0.03em; margin-bottom: 28px; max-width: 900px; margin-left: auto; margin-right: auto;"
        >
            Tu negocio
            <span style="color: var(--blue); white-space: nowrap;">
                <span id="tw-word"></span><span class="tw-cursor" aria-hidden="true"></span>
            </span>
            <br />cada día.
        </h1>

        <!-- Subheadline -->
        <p
            class="fade-in"
            style="font-family: 'Plus Jakarta Sans', sans-serif; font-size: clamp(16px, 2.2vw, 19px); color: #444; max-width: 560px; margin: 0 auto 44px; line-height: 1.65;"
        >
            No es falta de talento, es falta de sistema. Mientras dudas, el mercado elige a quien sabe posicionarse.
        </p>

        <!-- CTAs -->
        <div
            class="fade-in cta-group"
            style="display: flex; gap: 14px; flex-wrap: wrap; justify-content: center; margin-bottom: 36px;"
        >
            <a
                href="#contacto"
                style="font-family: 'Outfit', sans-serif; font-size: 16px; font-weight: 600; background: var(--blue); color: #fff; padding: 16px 32px; border-radius: var(--radius-btn); text-decoration: none; display: inline-flex; align-items: center; gap: 6px; transition: background 0.2s, transform 0.2s; min-height: 44px;"
                onmouseover="this.style.background='var(--navy)'; this.style.transform='translateY(-1px)'"
                onmouseout="this.style.background='var(--blue)'; this.style.transform='translateY(0)'"
            >
                Escalar mi negocio →
            </a>
            <a
                href="#sistema"
                style="font-family: 'Outfit', sans-serif; font-size: 16px; font-weight: 600; background: transparent; color: var(--navy); padding: 16px 32px; border-radius: var(--radius-btn); text-decoration: none; display: inline-flex; align-items: center; gap: 6px; border: 1.5px solid var(--navy); transition: background 0.2s, color 0.2s; min-height: 44px;"
                onmouseover="this.style.background='var(--navy)'; this.style.color='#fff'"
                onmouseout="this.style.background='transparent'; this.style.color='var(--navy)'"
            >
                Ver el sistema MIRO ↓
            </a>
        </div>

        <!-- Pill badges -->
        <div class="fade-in" style="display: flex; gap: 12px; flex-wrap: wrap; justify-content: center;">
            {['Captación', 'Ventas', 'Escala'].map((tag) => (
                <span
                    style="font-family: 'Outfit', sans-serif; font-weight: 500; font-size: 12px; letter-spacing: 0.04em; color: var(--gray); background: rgba(0,0,0,0.05); padding: 6px 16px; border-radius: 100px; border: 1px solid rgba(0,0,0,0.08);"
                >
                    {tag}
                </span>
            ))}
        </div>
    </div>
</section>

<script>
    // Vanilla typewriter effect
    const words = ['pierde ventas', 'deja dinero', 'pierde clientes', 'pierde tiempo'];
    let wordIdx = 0;
    let charIdx = 0;
    let deleting = false;

    const el = document.getElementById('tw-word');
    if (!el) throw new Error('tw-word not found');

    function tick() {
        const word = words[wordIdx];
        if (!deleting && charIdx < word.length) {
            el.textContent = word.slice(0, ++charIdx);
            setTimeout(tick, 70);
        } else if (!deleting && charIdx === word.length) {
            setTimeout(() => { deleting = true; tick(); }, 2000);
        } else if (deleting && charIdx > 0) {
            el.textContent = word.slice(0, --charIdx);
            setTimeout(tick, 40);
        } else {
            deleting = false;
            wordIdx = (wordIdx + 1) % words.length;
            setTimeout(tick, 200);
        }
    }

    tick();
</script>
