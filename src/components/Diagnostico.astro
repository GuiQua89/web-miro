---
// Pain points section — 3 cards
const cards = [
    {
        icon: '✕',
        title: 'Publicidad que no convierte',
        body: 'Mucha gente ve tus anuncios, pero nadie hace clic en comprar.',
    },
    {
        icon: '👻',
        title: 'Leads que desaparecen',
        body: 'Te preguntan precios y nunca más vuelven a responder.',
    },
    {
        icon: '🧍',
        title: 'Dependencia total de ti',
        body: 'Si no estás vendiendo manualmente, el negocio se detiene.',
    },
];
---

<section
    id="metodo"
    style="background: var(--white); padding: clamp(64px, 10vw, 110px) 24px;"
>
    <div style="max-width: var(--container); margin: 0 auto;">

        <!-- Header -->
        <div class="fade-in" style="text-align: center; margin-bottom: 64px;">
            <span
                style="display: inline-block; font-family: 'Outfit', sans-serif; font-size: 11px; font-weight: 600; letter-spacing: 0.14em; text-transform: uppercase; color: var(--blue); margin-bottom: 16px;"
            >
                EL DIAGNÓSTICO
            </span>
            <h2
                style="font-family: 'Outfit', sans-serif; font-size: clamp(26px, 4.5vw, 48px); font-weight: 800; color: var(--black); letter-spacing: -0.03em; margin-bottom: 18px; line-height: 1.1;"
            >
                ¿Estás cansado de quemar dinero?
            </h2>
            <p style="font-family: 'Plus Jakarta Sans', sans-serif; font-size: 16px; color: var(--gray); max-width: 520px; margin: 0 auto; line-height: 1.65;">
                La mayoría de las agencias se enfocan en hacer ruido. Nosotros nos enfocamos en traer dinero.
            </p>
        </div>

        <!-- Cards grid -->
        <div
            style="display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 24px;"
        >
            {cards.map((card, i) => (
                <div
                    class="fade-in"
                    style={`
                        background: var(--cream);
                        border-left: 3px solid var(--blue);
                        border-radius: var(--radius-card);
                        padding: 32px 28px;
                        box-shadow: var(--shadow-card);
                        transition: box-shadow 0.25s ease, transform 0.25s ease;
                        animation-delay: ${i * 100}ms;
                    `}
                    onmouseover="this.style.boxShadow='var(--shadow-hover)'; this.style.transform='translateY(-3px)'"
                    onmouseout="this.style.boxShadow='var(--shadow-card)'; this.style.transform='translateY(0)'"
                >
                    <div
                        style="width: 48px; height: 48px; background: rgba(26,95,212,0.08); border-radius: 10px; display: flex; align-items: center; justify-content: center; font-size: 22px; margin-bottom: 20px;"
                        aria-hidden="true"
                    >
                        {card.icon}
                    </div>
                    <h3
                        style="font-family: 'Outfit', sans-serif; font-size: 20px; font-weight: 700; color: var(--black); margin-bottom: 12px; letter-spacing: -0.01em;"
                    >
                        {card.title}
                    </h3>
                    <p style="font-family: 'Plus Jakarta Sans', sans-serif; font-size: 15px; color: var(--gray); line-height: 1.65;">
                        {card.body}
                    </p>
                </div>
            ))}
        </div>
    </div>
</section>
