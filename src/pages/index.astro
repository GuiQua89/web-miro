---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import Hero from '../components/Hero.astro';
import TechCarousel from '../components/TechCarousel.astro';
import Diagnostico from '../components/Diagnostico.astro';
import SistemaAIMA from '../components/SistemaAIMA.astro';
import Planes from '../components/Planes.astro';
import Nosotros from '../components/Nosotros.astro';
import FAQ from '../components/FAQ.astro';
import Contacto from '../components/Contacto.astro';
import Footer from '../components/Footer.astro';
import WAFloat from '../components/WAFloat.astro';

const schema = JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'ProfessionalService',
    name: 'MIRO',
    url: 'https://www.mirocreatives.com',
    description: 'Agencia de IA, automatizaciones y marketing digital en Panamá. Escalamos negocios en toda Latinoamérica.',
    slogan: "We don't design, we position.",
    image: 'https://www.mirocreatives.com/logo.png',
    address: {
        '@type': 'PostalAddress',
        addressLocality: 'Ciudad de Panamá',
        addressCountry: 'PA',
    },
    areaServed: ['Panamá', 'Costa Rica', 'Colombia', 'México', 'Argentina', 'Chile', 'Latinoamérica'],
    knowsLanguage: 'es',
    sameAs: [], // REVISAR: agregar URLs de redes sociales de MIRO
});
---

<BaseLayout
    title="MIRO | Agencia de IA y Marketing Digital en Panamá"
    description="Agencia de IA, automatizaciones y Meta Ads en Panamá. Escalamos negocios en toda Latinoamérica con el sistema AIMA. Consultoría gratuita."
    schemaData={schema}
>
    <Navbar />

    <main id="contenido-principal">
        <Hero />
        <TechCarousel />
        <Diagnostico />
        <SistemaAIMA />
        <Planes />
        <Nosotros />
        <FAQ />
        <Contacto />
    </main>

    <Footer />
    <WAFloat />
</BaseLayout>
