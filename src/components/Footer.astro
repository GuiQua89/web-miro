---
// Footer — black background, logo light version
---

<footer style="background: var(--black); padding: 40px 24px;">
    <div
        style="max-width: var(--container); margin: 0 auto; display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 20px;"
    >
        <!-- Logo (light version) -->
        <a href="/" aria-label="MIRO — inicio">
            <img
                src="/miro-dark.png"
                alt="MIRO"
                style="height: 100px; width: auto; display: block;"
                loading="lazy"
            />
        </a>

        <!-- Copyright -->
        <p
            style="font-family: 'Plus Jakarta Sans', sans-serif; font-size: 13px; color: rgba(255,255,255,0.3); text-align: right;"
        >
            © 2026 MIRO Estrategia Digital. Todos los derechos reservados.
        </p>
    </div>
</footer>
