---
// Tech ecosystem — infinite horizontal carousel, CSS-only animation
const tools = [
  { name: 'Make',         icon: 'make'         },
  { name: 'n8n',          icon: 'n8n'          },
  { name: 'Zapier',       icon: 'zapier'       },
  { name: 'OpenAI',       icon: 'openai'       },
  { name: 'Anthropic',    icon: 'anthropic'    },
  { name: 'Gemini',       icon: 'googlegemini' },
  { name: 'Notion',       icon: 'notion'       },
  { name: 'Airtable',     icon: 'airtable'     },
  { name: 'HubSpot',      icon: 'hubspot'      },
  { name: 'Slack',        icon: 'slack'        },
  { name: 'Meta',         icon: 'meta'         },
  { name: 'WhatsApp',     icon: 'whatsapp'     },
  { name: 'Astro',        icon: 'astro'        },
  { name: 'Tailwind CSS', icon: 'tailwindcss'  },
  { name: 'WordPress',    icon: 'wordpress'    },
]

const cdn = 'https://cdn.jsdelivr.net/gh/simple-icons/simple-icons/icons/'
// Duplicate items for seamless infinite loop (translateX -50%)
const doubled = [...tools, ...tools]
---

<section class="py-24 border-y border-white/5 bg-black/40 overflow-hidden">
  <div class="container mx-auto px-6 md:px-8">
    <div class="mb-12 text-center reveal">
      <h2 class="font-headline text-3xl font-bold text-white mb-3">Ecosistema tecnológico</h2>
      <p class="text-on-surface-variant max-w-xl mx-auto text-sm">
        Utilizo las herramientas líderes del mercado para crear sistemas robustos que no requieren mantenimiento constante.
      </p>
    </div>
  </div>

  <!-- Carousel bleeds full width outside the container -->
  <div class="carousel-wrapper carousel-fade" role="list" aria-label="Herramientas y plataformas">
    <div class="carousel-track">
      {doubled.map((tool, i) => (
        <div
          class="tool-item flex flex-col items-center gap-2.5 px-8 py-5 rounded-xl hover:bg-white/[0.04] transition-colors group cursor-default"
          role="listitem"
          aria-label={i < tools.length ? tool.name : undefined}
          aria-hidden={i >= tools.length ? 'true' : undefined}
        >
          <img
            src={`${cdn}${tool.icon}.svg`}
            alt=""
            class="tool-logo"
            width="36"
            height="36"
            loading="lazy"
          />
          <span class="font-label text-[10px] tracking-widest uppercase text-on-surface-variant/40 group-hover:text-primary transition-colors">
            {tool.name}
          </span>
        </div>
      ))}
    </div>
  </div>
</section>
