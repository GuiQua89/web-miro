---
// CTA final section — navy background
---

<section
    id="contacto"
    style="background: var(--navy); padding: clamp(72px, 10vw, 120px) 24px; text-align: center;"
>
    <div style="max-width: 640px; margin: 0 auto;">
        <span
            style="display: inline-block; font-family: 'Outfit', sans-serif; font-size: 11px; font-weight: 600; letter-spacing: 0.14em; text-transform: uppercase; color: rgba(255,255,255,0.45); margin-bottom: 24px;"
        >
            CONTACTO
        </span>

        <h2
            style="font-family: 'Outfit', sans-serif; font-size: clamp(36px, 5vw, 60px); font-weight: 800; color: #fff; letter-spacing: -0.03em; line-height: 1.05; margin-bottom: 20px;"
        >
            Es hora de actuar.
        </h2>

        <p style="font-family: 'Plus Jakarta Sans', sans-serif; font-size: 18px; color: rgba(255,255,255,0.72); margin-bottom: 48px; line-height: 1.65;">
            No agendes si querés información. Agenda solo si estás listo para implementar el sistema que cambiará tu negocio.
        </p>

        <!-- CTA buttons -->
        <div
            style="display: flex; gap: 12px; justify-content: center; flex-wrap: wrap; margin-bottom: 28px;"
        >
            <!-- WhatsApp button (primary) -->
            <a
                href="https://wa.me/NUMERO"
                target="_blank"
                rel="noopener noreferrer"
                aria-label="Hablar con MIRO por WhatsApp"
                style="display: inline-flex; align-items: center; gap: 10px; font-family: 'Outfit', sans-serif; font-size: 16px; font-weight: 600; background: #fff; color: var(--navy); padding: 16px 32px; border-radius: var(--radius-btn); text-decoration: none; transition: background 0.2s, transform 0.2s; min-height: 44px;"
                onmouseover="this.style.background='#f0f0f0'; this.style.transform='translateY(-1px)'"
                onmouseout="this.style.background='#fff'; this.style.transform='translateY(0)'"
            >
                <!-- WhatsApp SVG icon -->
                <svg width="18" height="18" viewBox="0 0 24 24" fill="#25D366" aria-hidden="true">
                    <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
                </svg>
                Hablar por WhatsApp
            </a>

            <!-- Calendly button (secondary) -->
            <a
                href="https://calendly.com/LINK"
                target="_blank"
                rel="noopener noreferrer"
                aria-label="Agendar llamada de 30 minutos"
                style="display: inline-flex; align-items: center; gap: 10px; font-family: 'Outfit', sans-serif; font-size: 16px; font-weight: 600; background: transparent; color: #fff; padding: 16px 32px; border-radius: var(--radius-btn); text-decoration: none; border: 1.5px solid rgba(255,255,255,0.4); transition: border-color 0.2s, background 0.2s, transform 0.2s; min-height: 44px;"
                onmouseover="this.style.borderColor='#fff'; this.style.background='rgba(255,255,255,0.08)'; this.style.transform='translateY(-1px)'"
                onmouseout="this.style.borderColor='rgba(255,255,255,0.4)'; this.style.background='transparent'; this.style.transform='translateY(0)'"
            >
                <!-- Calendar icon -->
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <rect x="3" y="4" width="18" height="18" rx="2" ry="2"/>
                    <line x1="16" y1="2" x2="16" y2="6"/>
                    <line x1="8" y1="2" x2="8" y2="6"/>
                    <line x1="3" y1="10" x2="21" y2="10"/>
                </svg>
                Agendar llamada (30 min)
            </a>
        </div>

        <!-- Fine print -->
        <p
            style="font-family: 'Plus Jakarta Sans', sans-serif; font-size: 13px; color: rgba(255,255,255,0.38); letter-spacing: 0.02em;"
        >
            Consultoría 100% gratuita · Solo 3 cupos mensuales para nuevos proyectos
        </p>
    </div>
</section>
