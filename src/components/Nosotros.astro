---
import { Image } from 'astro:assets';
import teamImg from '../assets/images/team.png';

// Team section
const badges = ['Innovación', 'Confianza', 'Creatividad'];
---

<section
    id="nosotros"
    style="background: var(--cream); padding: clamp(64px, 10vw, 110px) 24px;"
>
    <div style="max-width: var(--container); margin: 0 auto;">

        <!-- Header -->
        <div class="fade-in" style="text-align: center; margin-bottom: 52px;">
            <span
                style="display: inline-block; font-family: 'Outfit', sans-serif; font-size: 11px; font-weight: 600; letter-spacing: 0.14em; text-transform: uppercase; color: var(--blue); margin-bottom: 16px;"
            >
                NOSOTROS
            </span>
            <h2
                style="font-family: 'Outfit', sans-serif; font-size: clamp(26px, 4.5vw, 48px); font-weight: 800; color: var(--black); letter-spacing: -0.03em; margin-bottom: 18px; line-height: 1.1;"
            >
                El equipo detrás de MIRO
            </h2>
            <p style="font-family: 'Plus Jakarta Sans', sans-serif; font-size: 16px; color: var(--gray); max-width: 560px; margin: 0 auto; line-height: 1.7;">
                No somos una agencia masiva. Somos un equipo pequeño, estratégico y selectivo. Trabajamos con pocos clientes para garantizar resultados brutales.
            </p>
        </div>

        <!-- Team photo -->
        <div class="fade-in" style="display: flex; flex-direction: column; align-items: center; gap: 20px;">
            <Image
                src={teamImg}
                alt="El equipo de MIRO: Francelis, Jeffry y Rakesh"
                width={680}
                loading="lazy"
                style="max-width: 680px; width: 100%; border-radius: 16px; box-shadow: 0 8px 40px rgba(0,0,0,0.12); display: block; height: auto;"
            />
            <p style="font-family: 'Plus Jakarta Sans', sans-serif; font-size: 14px; color: var(--gray); letter-spacing: 0.03em;">
                Francelis · Jeffry · Rakesh
            </p>

            <!-- Badges -->
            <div style="display: flex; flex-wrap: wrap; gap: 12px; justify-content: center; margin-top: 8px;">
                {badges.map((badge) => (
                    <span
                        style="font-family: 'Outfit', sans-serif; font-size: 13px; font-weight: 500; color: var(--blue); border: 1.5px solid var(--blue); padding: 7px 20px; border-radius: 100px; letter-spacing: 0.02em;"
                    >
                        {badge}
                    </span>
                ))}
            </div>
        </div>
    </div>
</section>
